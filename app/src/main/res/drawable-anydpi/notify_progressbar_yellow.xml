<?xml version="1.0" encoding="utf-8"?>
<layer-list
xmlns:android="http://schemas.android.com/apk/res/android">
<item android:id="@android:id/background"
        android:height="8.0dip">
        <shape>
            <solid android:color="@color/black50" />
            <corners android:bottomRightRadius="@dimen/_6sdp"
                     android:bottomLeftRadius="@dimen/_6sdp"/>
        </shape>
</item>
<item android:id="@android:id/progress"
        android:height="8.0dip">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/gradient1"
                          android:endColor="@color/gradient2"
                          android:angle="180.0"
                          android:type="linear" />
                <corners android:bottomRightRadius="@dimen/_5sdp"
                         android:bottomLeftRadius="@dimen/_5sdp"/>
            </shape>
        </clip>
</item>
</layer-list>